{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prabhavalabs/agentmeter/schemas/desktop-ipc-v1.schema.json",
  "title": "AgentMeter desktop IPC message version 1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "messageType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "type", "payload"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "hello", "status.get", "events.subscribe", "device.scan",
            "device.connect", "device.disconnect", "device.forget",
            "device.identify", "device.refresh", "device.sync", "settings.get",
            "settings.patch", "providers.refresh", "providers.update",
            "history.query", "history.summary", "history.hourly",
            "history.clear", "diagnostics.get",
            "bridge.restart", "system.sleep", "system.wake"
          ]
        },
        "payload": { "type": "object" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "type", "status", "payload"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/messageType" },
        "status": { "const": "ok" },
        "payload": { "type": "object" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "type", "status", "payload"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "error" },
        "status": { "const": "error" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "recoverable"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 64 },
            "message": { "type": "string", "minLength": 1, "maxLength": 256 },
            "recoverable": { "type": "boolean" }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "type", "payload"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^event-[1-9][0-9]*$" },
        "type": { "$ref": "#/$defs/messageType" },
        "payload": { "type": "object" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prabhavalabs/agentmeter/schemas/device-snapshot-v1.schema.json",
  "title": "AgentMeter device snapshot version 1",
  "type": "object",
  "required": [
    "schemaVersion",
    "messageId",
    "generatedAtEpoch",
    "staleAfterSeconds",
    "providers",
    "display",
    "event"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "messageId": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "generatedAtEpoch": { "type": "integer", "minimum": 0 },
    "staleAfterSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
    "providers": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/provider" }
    },
    "display": { "$ref": "#/$defs/display" },
    "event": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/event" }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 23,
      "pattern": "^[a-z0-9_-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 23
    },
    "window": {
      "type": "object",
      "required": ["kind", "label", "usedPercent", "resetAtEpoch"],
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/label" },
        "usedPercent": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 100 },
            { "type": "null" }
          ]
        },
        "resetAtEpoch": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        }
      }
    },
    "provider": {
      "type": "object",
      "required": ["id", "name", "status", "windows"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/label" },
        "status": {
          "enum": ["ok", "stale", "error", "unavailable"]
        },
        "windows": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/window" }
        }
      }
    },
    "display": {
      "type": "object",
      "required": [
        "brightnessPercent",
        "dimAfterSeconds",
        "screenOffAfterSeconds",
        "alertThresholds",
        "soundEnabled"
      ],
      "properties": {
        "brightnessPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "dimAfterSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
        "screenOffAfterSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
        "alertThresholds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 100 }
        },
        "soundEnabled": { "type": "boolean" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "kind", "level", "expiresAtEpoch"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 96 },
        "kind": { "enum": ["threshold", "reset", "provider_error"] },
        "level": { "enum": ["info", "warning", "critical"] },
        "expiresAtEpoch": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
